# ==========================================
# Code Intelligence Studio Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="Code Intelligence Studio"
API_V1_STR=/api/v1
SECRET_KEY=super-secret-codeintel-key-change-in-production-min-32-chars

# CORS (comma-separated allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Relational Database (Local SQLite default)
DATABASE_URL=sqlite:///./data/codeintel.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://codeintel:password@localhost:5432/codeintel

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=codeintel_chunks

# Workspaces & Filesystem
WORKSPACE_ROOT=./workspaces
ARTIFACTS_ROOT=./artifacts
LOGS_ROOT=./logs

# GitHub Integration
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM Providers (Configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Execution Sandbox Policy
SANDBOX_MODE=subprocess
# Options: 'docker' (recommended for production), 'subprocess' (Windows workstation fallback)
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=2048

# Token Management
DEFAULT_TOKEN_BUDGET=16000
MAX_AGENT_CONCURRENCY=4
